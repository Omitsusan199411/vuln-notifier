// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 脆弱性の深刻度
enum Severity {
  unknown
  low
  medium
  high
  critical

  @@map("severity")
}

// バッチのトリガー種別（scheduled: 定期実行, manual: 手動実行）
enum BatchTriggerType {
  scheduled
  manual

  @@map("batch_trigger_type")
}

// バッチの実行ステータス
enum BatchStatus {
  pending
  running
  success
  failed

  @@map("batch_status")
}

// 通知チャンネルの種別
enum NotificationChannelType {
  line

  @@map("notification_channel_type")
}

// アドバイザリの取得元（将来 osv などを追加予定）
enum AdvisorySource {
  github

  @@map("advisory_source")
}

// ecosystemの種別
enum EcosystemName {
  rubygems
  npm
  pip
  maven
  nuget
  composer
  go
  rust
  erlang
  actions
  pub
  other
  swift

  @@map("ecosystem_name")
}

enum Role {
  admin
  general

  @@map("role")
}

enum SortOrder {
  desc
  asc

  @@map("sort_order")
}

// ユーザーモデル
model User {
  id         String   @id @default(nanoid())
  cognitoSub String   @unique @map("cognito_sub")
  role Role @default(general)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  batches              Batch[]
  notificationChannels NotificationChannel[]
  userLlmTokenUsages UserLlmTokenUsage[]
  userLlmTokenBudget UserLlmTokenBudget?

  @@map("users")
}

// エコシステム（パッケージ管理ツール）モデル
model Ecosystem {
  id        String   @id @default(nanoid())
  name      EcosystemName  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vulnerabilities      Vulnerability[]
  notificationChannelEcosystems NotificationChannelEcosystem[]

  @@map("ecosystems")
}

model Vulnerability {
  id                     String    @id @default(uuid(7))
  sourceAdvisoryId       String    @map("source_advisory_id")
  advisorySource         AdvisorySource @map("advisory_source")
  cveId                  String    @map("cve_id")
  ecosystemId            String    @map("ecosystem_id")
  batchId                String    @map("batch_id")
  packageName            String    @map("package_name")
  severity               Severity
  cvssScore              Float?  @map("cvss_score")
  summary                String
  llmSummary             String?   @map("llm_summary")
  advisoryUrl            String    @map("advisory_url")
  publishedAt            DateTime  @map("published_at")
  sourceUpdatedAt        DateTime  @map("source_updated_at")
  sourceResponse         Json      @map("source_response")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  ecosystem     Ecosystem      @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)
  batch         Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([sourceAdvisoryId, ecosystemId, packageName])
  @@index([updatedAt])
  @@index([batchId])
  @@map("vulnerabilities")
}

model Batch {
  id          String           @id @default(uuid(7))
  triggerType BatchTriggerType @map("trigger_type")
  triggeredBy String?          @map("triggered_by")
  executedAt  DateTime         @map("executed_at")
  status      BatchStatus
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user            User?           @relation(fields: [triggeredBy], references: [id], onDelete: SetNull)
  vulnerabilities Vulnerability[]

  @@index([triggerType, executedAt])
  @@index([triggeredBy, executedAt])
  @@index([status])
  @@map("batches")
}

model NotificationChannel {
  id                   String                  @id @default(nanoid())
  userId               String                  @map("user_id")
  type                 NotificationChannelType
  maxNotificationLimit Int                     @default(10) @map("max_notification_limit")
  enabled              Boolean                 @default(true)
  minSeverity Severity @default(high) @map("min_severity")
  minCvssScore            Float @default(7.0) @map("min_cvss_score")
  cvssScoreOrderBy SortOrder @default(desc) @map("cvss_score_order_by")
  notificationIntervalMinutes Int @default(1440) @map("notification_interval_minutes")
  lastProcessedAt DateTime? @map("last_processed_at") 
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineChannel   LineChannel?
  notifications Notification[]
  notificationChannelEcosystems NotificationChannelEcosystem[]

  @@index([userId, enabled])
  @@map("notification_channels")
}

model LineChannel {
  id                    String   @id @default(nanoid())
  notificationChannelId String   @unique @map("notification_channel_id")
  lineUserId            String   @unique @map("line_user_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  notificationChannel NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)

  @@map("line_channels")
}

model Notification {
  id                    String   @id @default(uuid(7))
  notificationChannelId String   @map("notification_channel_id")
  vulnerabilityId       String   @map("vulnerability_id")
  notifiedAt            DateTime @default(now()) @map("notified_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  notificationChannel NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)
  vulnerability       Vulnerability       @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@index([notifiedAt])
  @@index([notificationChannelId, createdAt])
  @@map("notifications")
}

model NotificationChannelEcosystem {
  id String @id @default(nanoid())
  notificationChannelId String @map("notification_channel_id")
  ecosystemId String @map("ecosystem_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notificationChannel NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)
  ecosystem Ecosystem @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)

  @@unique([notificationChannelId, ecosystemId])

  @@map("notification_channel_ecosystems")
}

model LlmModel {
  id String @id @default(nanoid())
  name String @unique
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appLlmTokenUsages AppLlmTokenUsage[]
  userLlmTokenUsages UserLlmTokenUsage[]

  @@map("llm_models")
}

model AppLlmTokenUsage {
  id           String   @id @default(nanoid())
  year         Int
  month        Int
  modelId String @map("model_id")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  llmModel LlmModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, year, month])
  @@map("app_llm_token_usages")
}

model UserLlmTokenUsage {
  id String @id @default(nanoid())
  userId String @map("user_id")
  year Int
  month Int
  modelId String @map("model_id")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens") 
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  llmModel LlmModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId, year, month])
  @@map("user_llm_token_usages")
}

model UserLlmTokenBudget{
  id String @id @default(nanoid())
  userId String @unique @map("user_id")
  monthlyTokenBudget Int @map("monthly_token_budget")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_llm_token_budgets")

}

model VulnerabilityAutoFetchSetting {
  id String @id @default(nanoid())
  intervalMinutes Int @default(60) @map("interval_minutes")
  maxFetchCount Int @default(100) @map("max_fetch_count")
  lookbackDays Int @default(1) @map("lookback_days")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vulnerability_auto_fetch_settings")
}

model VulnerabilityManualFetchSetting {
  id String @id @default(nanoid())
  maxFetchCount Int @default(30) @map("max_fetch_count")
  maxLookbackDays Int @default(1) @map("max_lookback_days")
  minIntervalMinutes Int @default(60) @map("min_interval_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vulnerability_manual_fetch_settings")
}
