{
	"name": "api",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "prisma generate && tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"type:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"connect:dev-db": "prisma studio -p 5555",
		"connect:test-db": "DATABASE_URL=$TEST_DATABASE_URL prisma studio -p 5555"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@repo/shared": "workspace:*",
		"hono": "^4.12.34",
		"pg": "^8.21.0",
		"pino": "^10.3.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@faker-js/faker": "catalog:",
		"@types/node": "catalog:",
		"fishery": "^2.4.0",
		"prisma": "^7.8.0",
		"tsx": "^4.7.1",
		"typescript": "catalog:"
	}
}
