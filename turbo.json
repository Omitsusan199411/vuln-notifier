{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"env": ["DATABASE_URL", "TEST_DATABASE_URL", "CORS_ORIGIN"]
		},
		"test": {
			"outputs": [],
			"env": ["DATABASE_URL", "TEST_DATABASE_URL", "CORS_ORIGIN"]
		},
		"test:watch": {
			"cache": false,
			"persistent": true,
			"env": ["DATABASE_URL", "TEST_DATABASE_URL", "CORS_ORIGIN"]
		},
		"test:coverage": {
			"outputs": ["../../coverage/**"],
			"env": ["DATABASE_URL", "TEST_DATABASE_URL", "CORS_ORIGIN"]
		}
	}
}
